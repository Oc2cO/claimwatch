{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claimwatch.example.invalid/schema/claim-record-v1.json",
  "title": "Claim record (ClaimWatch demo data)",
  "description": "One sanitized claim-watch record: source, extracted assertions, evidence receipts, verdict state machine, history, alert expectation, and the test expectation the engine is graded against. Schema version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "schema_version",
    "suite",
    "run_id",
    "title",
    "source",
    "claims",
    "receipts",
    "evidence_checklist",
    "verdict",
    "history",
    "alert",
    "engine_expectation",
    "notes"
  ],
  "definitions": {
    "iso8601": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "verdict_state": {
      "type": "string",
      "enum": ["SUBSTANCE", "UNVERIFIED", "REFUTED", "PENDING"]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "EVIDENCE_SUFFICIENT",
        "EVIDENCE_MISSING",
        "EVIDENCE_CONTRADICTS",
        "CLAIM_UNCHECKABLE",
        "DUPLICATE_CLAIM",
        "SOURCE_UNREACHABLE",
        "PRICING_STALE",
        "SCOPE_MISMATCH",
        "TEMPORAL_MISMATCH",
        "RUN_EMPTY",
        "RUN_PARTIAL"
      ]
    },
    "alert_rule": {
      "type": "string",
      "enum": [
        "none",
        "A1_VERDICT_DOWNGRADE",
        "A2_EMPTY_RUN",
        "A3_UNSUPPORTED_ASSERTION",
        "A4_REFUTED",
        "A5_DUPLICATE_FLOOD"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "text", "kind", "checkable"],
      "properties": {
        "assertion_id": {"type": "string", "pattern": "^A[0-9]+$"},
        "text": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["quantitative", "causal", "comparative", "temporal", "existence"]
        },
        "checkable": {"type": "boolean"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "kind",
        "ref",
        "retrieved_at",
        "supports_assertion",
        "relation",
        "artifact_sha256",
        "note"
      ],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^R[0-9]+$"},
        "kind": {
          "type": "string",
          "enum": [
            "invoice",
            "token_export",
            "pricing_page",
            "benchmark",
            "screenshot",
            "support_thread",
            "none"
          ]
        },
        "ref": {"type": "string", "minLength": 1},
        "retrieved_at": {"$ref": "#/definitions/iso8601"},
        "supports_assertion": {"type": ["string", "null"], "pattern": "^A[0-9]+$"},
        "relation": {"type": "string", "enum": ["supports", "contradicts", "insufficient"]},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "note": {"type": "string"}
      }
    },
    "checklist_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "satisfied", "evidence_ids"],
      "properties": {
        "item": {"type": "string", "minLength": 1},
        "satisfied": {"type": "boolean"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^R[0-9]+$"}}
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "state", "reason_code", "basis", "evidence_ids"],
      "properties": {
        "at": {"$ref": "#/definitions/iso8601"},
        "state": {"$ref": "#/definitions/verdict_state"},
        "reason_code": {"$ref": "#/definitions/reason_code"},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^R[0-9]+$"}}
      }
    }
  },
  "properties": {
    "case_id": {"type": "string", "pattern": "^(DEMO-CASE|BULK)-[0-9]{3}$"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "suite": {"type": "string", "enum": ["core_demo", "bulk", "adversarial"]},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "retrieved_at", "author_pseudonym", "distribution"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["social_post", "blog", "press_release", "internal_transcript", "synthetic_document"]
        },
        "ref": {"type": "string", "minLength": 1},
        "retrieved_at": {"$ref": "#/definitions/iso8601"},
        "author_pseudonym": {"type": "string", "minLength": 1},
        "distribution": {"type": "string", "const": "synthetic"}
      }
    },
    "claims": {"type": "array", "items": {"$ref": "#/definitions/assertion"}},
    "receipts": {"type": "array", "items": {"$ref": "#/definitions/receipt"}},
    "evidence_checklist": {"type": "array", "items": {"$ref": "#/definitions/checklist_item"}},
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason_code", "basis", "confidence", "decided_at"],
      "properties": {
        "state": {"$ref": "#/definitions/verdict_state"},
        "reason_code": {"$ref": "#/definitions/reason_code"},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "decided_at": {"$ref": "#/definitions/iso8601"}
      }
    },
    "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/history_entry"}},
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["should_fire", "rule_id", "severity"],
      "properties": {
        "should_fire": {"type": "boolean"},
        "rule_id": {"$ref": "#/definitions/alert_rule"},
        "severity": {"type": "string", "enum": ["none", "low", "medium", "high", "critical"]}
      }
    },
    "engine_expectation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["expected_state", "expected_alert", "must_cite", "must_not"],
      "properties": {
        "expected_state": {"$ref": "#/definitions/verdict_state"},
        "expected_alert": {"type": "boolean"},
        "must_cite": {"type": "array", "items": {"type": "string"}},
        "must_not": {"type": "array", "items": {"type": "string"}}
      }
    },
    "notes": {"type": "string"}
  }
}
